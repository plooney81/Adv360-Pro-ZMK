#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

// ============================================================
// Layer indices -- mirrors your Planck naming convention.
// On the Planck these were 0=Lower, 1=Base, 2=Raise, 3=Adjust,
// 4=Mouse, 5=Move. ZMK uses 0 for default, so BASE is first
// here, but the names map directly.
// ============================================================
#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3
#define MOUSE  4
#define MOVE   5

/ {
    // Tri-layer: holding LOWER + RAISE simultaneously activates ADJUST.
    // This is the Planck pattern, native in ZMK.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        #include "macros.dtsi"

        // Esc/Cmd mod-tap (matches your Planck thumb).
        // Tap = Esc, hold = LGUI (Cmd on Mac).
        esc_cmd: esc_cmd_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "ESC_CMD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Home-row mods -- defined for later, NOT used on base yet.
        // When acclimated (week 3+), swap &kp A -> &hm LGUI A etc.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // BASE -- QWERTY, Planck thumbs ported to 360.
        //
        // LEFT THUMB CLUSTER (outer -> inner across the cluster):
        //   row 1 (top of cluster):  &none, MOVE-hold
        //   row 2:                   LCTRL, LALT
        //   row 3 (big keys):        BSPC, DEL
        //   The big inner left thumb = LOWER-hold.
        //
        // RIGHT THUMB CLUSTER:
        //   The big inner right thumb = RAISE-hold.
        //   Adjacent: Space, Enter
        //   Outer: extra modifiers / passthrough
        //
        // OUTER COLUMNS (extra real estate vs Planck):
        //   Left outer: TAB, esc_cmd (tap=Esc, hold=Cmd), Shift, MOVE-hold
        //   Right outer: BSLH, SQT (matches your Planck right-pinky)
        // ============================================================
        default_layer {
            bindings = <
&kp EQUAL          &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &none                                                                          &mo ADJUST    &kp N6   &kp N7   &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB            &kp Q    &kp W    &kp E    &kp R    &kp T    &none                                                                          &none         &kp Y    &kp U    &kp I      &kp O    &kp P     &kp BSLH
&esc_cmd ESC LGUI  &kp A    &kp S    &kp D    &kp F    &kp G    &none      &kp LCTRL  &kp LALT     &kp LGUI    &kp RCTRL  &none                              &kp H    &kp J    &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT          &kp Z    &kp X    &kp C    &kp V    &kp B    &none      &none      &kp HOME     &none       &none      &kp PG_UP   &none      &none       &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&mo MOVE           &kp GRAVE &kp CAPS &kp LBKT &kp RBKT &kp BSPC &kp DEL    &kp END    &kp PG_DN   &kp ENTER   &kp SPACE  &mo LOWER   &mo RAISE &kp LBRC     &kp RBRC &kp ENTER
            >;
        };

        // ============================================================
        // LOWER -- symbols. Held by left thumb (mirrors Planck Lower).
        //
        // Mapped from your Planck Lower layer:
        //   Top row:    ~ ! @ # $ %  |  ^ & * - _ Del
        //   Mid row:    -- A S { } \  |  / ( ) + - =
        //   Lower row:  Sh Z X < > B  |  N [ ] | \ :
        //
        // Outer columns on 360 get extras that didn't fit on Planck.
        // ============================================================
        lower_layer {
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &trans                                                       &trans   &kp CARET  &kp AMPS  &kp ASTRK  &kp MINUS  &kp UNDER  &kp DEL
&trans     &trans    &trans    &kp LBRC  &kp RBRC  &kp BSLH   &trans                                                       &trans   &kp FSLH   &kp LPAR  &kp RPAR   &kp PLUS   &kp MINUS  &kp EQUAL
&trans     &trans    &trans    &kp LT    &kp GT    &trans     &trans   &trans  &trans  &trans  &trans  &trans                       &trans     &kp LBKT  &kp RBKT   &kp PIPE   &kp BSLH   &kp COLON
&trans     &trans    &trans    &trans    &trans    &trans     &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans     &trans    &trans     &trans     &trans     &trans
&trans     &trans    &trans    &trans    &trans    &trans     &trans   &trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans     &trans
            >;
        };

        // ============================================================
        // RAISE -- numbers + numpad. Held by right thumb.
        //
        // Mapped from your Planck Raise layer:
        //   Top:  ` 1 2 3 4 5  |  6 7 8 9 0 BSPC
        //   Mid:  -- (transparent) -- |  numpad 4 5 6 - +
        //   Low:  -- (transparent) -- |  numpad 1 2 3 / *
        //   Thumbs: -- numpad 0, ., =
        // ============================================================
        raise_layer {
            bindings = <
&kp GRAVE  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &trans                                                          &trans   &kp N6   &kp N7        &kp N8        &kp N9        &kp N0           &kp BSPC
&trans     &trans   &trans   &trans   &trans   &trans   &trans                                                          &trans   &trans   &kp KP_N4     &kp KP_N5     &kp KP_N6     &kp KP_MINUS     &kp KP_PLUS
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans                          &trans   &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_DIVIDE    &kp KP_MULTIPLY
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans   &trans        &trans        &trans        &trans           &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans  &kp KP_N0 &kp KP_DOT &kp KP_EQUAL &trans &trans   &trans
            >;
        };

        // ============================================================
        // ADJUST -- function keys + media + system.
        // Activated AUTOMATICALLY when LOWER + RAISE both held.
        //
        // Mapped from your Planck Adjust layer:
        //   Top: F1-F12
        //   Mid: Vol-/Vol+/Mute, brightness controls, Eject
        //   Low: Play, Rewind, Fast-forward, Reset
        // ============================================================
        adjust_layer {
            bindings = <
&kp F1            &kp F2        &kp F3       &kp F4   &kp F5   &kp F6   &trans                                                  &trans   &kp F7        &kp F8        &kp F9        &kp F10       &kp F11   &kp F12
&kp C_VOL_DN      &kp C_VOL_UP  &kp C_MUTE   &trans   &trans   &trans   &trans                                                  &trans   &kp C_BRI_DN  &kp C_BRI_UP  &trans        &trans        &trans    &kp K_POWER
&trans            &trans        &trans       &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans    &trans
&trans            &trans        &trans       &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans    &trans
&kp C_PLAY_PAUSE  &kp C_PREV    &kp C_NEXT   &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &reset    &trans
            >;
        };

        // ============================================================
        // MOUSE -- placeholder. ZMK mouse keys require enabling
        // CONFIG_ZMK_MOUSE=y in adv360.conf and are still flagged
        // experimental. Layer reserved so numbering matches your
        // Planck mental model. Wire up real mouse bindings later.
        // ============================================================
        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // ============================================================
        // MOVE -- navigation. Held by bottom-left thumb (mo MOVE).
        //
        // Mapped from your Planck Move layer:
        //   Top right: PgDn, Up, PgUp on top row; Del at far right
        //   Mid right: Left, Down, Right (Vim-style on home position)
        //
        // Right hand stays anchored on home row, left hand passes through
        // (so chords like Cmd+Right still work).
        // ============================================================
        move_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &kp PG_DN  &kp UP    &kp PG_UP  &trans   &trans   &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans     &trans    &trans     &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans    &trans     &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans
            >;
        };
    };
};
